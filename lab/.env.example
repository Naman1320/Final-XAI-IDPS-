LAB_VICTIM_PASSWORD=
# Dashboard login for the lab SOC (user "admin"), at least 12 characters.
LAB_SOC_ADMIN_PASSWORD=

# --- Integrations (all optional; leave blank to keep them off). Placeholders only: put real
# values in lab/.env, which is git-ignored. See docs/soc.md "Integrations" and lab/README.md.
# The lab SOC can't open outbound connections, so try them against receivers on its own
# loopback (lab/soc/listen.py) with the two ALLOW flags below. DEV/LAB ONLY: never in production.
LAB_NOTIFY_ALLOW_PRIVATE=
LAB_NOTIFY_ALLOW_HTTP=
LAB_NOTIFY_MIN_SEVERITY=
LAB_SOC_PUBLIC_URL=
LAB_WEBHOOK_URL=
LAB_WEBHOOK_SECRET=
LAB_SLACK_WEBHOOK_URL=
LAB_SMTP_HOST=
LAB_SMTP_PORT=
LAB_SMTP_SECURITY=
LAB_SMTP_USERNAME=
LAB_SMTP_PASSWORD=
LAB_SMTP_FROM=
LAB_SMTP_TO=
LAB_SYSLOG_HOST=
LAB_SYSLOG_PORT=
LAB_SYSLOG_PROTOCOL=
LAB_SYSLOG_CA_FILE=
LAB_ABUSEIPDB_KEY=
# The lab SOC can't reach the internet. To let it reach HTTPS services (AbuseIPDB, Slack, an
# HTTPS webhook), list their hosts, e.g. api.abuseipdb.com,hooks.slack.com. HTTPS only. Email is
# separate: a public LAB_SMTP_HOST is reachable on LAB_SMTP_PORT (25, 465 or 587) and nothing else;
# no need to list it here. Syslog stays blocked. Risks: lab/README.md, "How the lab is isolated".
# Optional Claude assistant. Setting this key enables HTTPS to api.anthropic.com for the SOC.
ANTHROPIC_API_KEY=
# A Gemini Developer API key selects Google for the assistant and enables HTTPS to its API.
GEMINI_API_KEY=
IDPS_SOC_GEMINI_MODEL=gemini-3.8-flash
# A Groq key takes precedence and enables SOC access to api.groq.com.
GROQ_API_KEY=
IDPS_SOC_GROQ_MODEL=openai/gpt-oss-20b
LAB_SOC_EGRESS_HOSTS=
# Extra sensors allowed on the SOC's mutual-TLS port 8444, by mgmt_net address (comma-separated).
# The cloud collector (lab/cloud/README.md, "C4") is 10.10.3.3. Blank = only the lab sensor.
LAB_SOC_EXTRA_SENSOR_ADDRS=

# --- SOC database (roadmap step 10). postgres (default: the soc-db container, which makes its
# own password) or sqlite. Moving to postgres copies an existing soc.db across once, on start.
LAB_SOC_DATABASE=
# Data retention in days, 0 = keep forever; blank keeps the SOC's defaults (docs/soc.md).
LAB_ALERT_RETENTION_DAYS=
LAB_AUDIT_RETENTION_DAYS=

# --- Step 11: security ------------------------------------------------------------------------
# Sensors talk to the SOC over mutual TLS on port 8444 (true, the default) or with a token alone
# on 8443 (false).
LAB_SOC_SENSOR_MTLS=
# Admins must use an authenticator app (blank = required). false is for a quick lab test only.
LAB_SOC_MFA_REQUIRED_FOR_ADMINS=
# Optional single sign-on with an OpenID Connect provider (Keycloak, Entra ID, Google ...).
# In the unified dashboard, register http://127.0.0.1:5173/lab/auth/callback for the lab.
# Add the provider's host name to LAB_SOC_EGRESS_HOSTS so the SOC can reach it.
LAB_SOC_OIDC_ISSUER=
LAB_SOC_OIDC_CLIENT_ID=
LAB_SOC_OIDC_CLIENT_SECRET=
LAB_SOC_OIDC_REDIRECT_URI=

# --- Step 13: reports and privacy ------------------------------------------------------------
# Shown in the public privacy notice (dashboard /privacy). Blank = not published.
LAB_PRIVACY_CONTROLLER_NAME=
LAB_PRIVACY_CONTACT_EMAIL=
LAB_PRIVACY_GRIEVANCE_OFFICER=
# Who-viewed-what log of personal data; blank = 365 days.
LAB_ACCESS_LOG_RETENTION_DAYS=
# Email the weekly PDF every Monday 06:00 UTC through the LAB_SMTP_* settings (true/false),
# to LAB_REPORT_EMAIL_TO (blank = LAB_SMTP_TO). LAB_REPORT_MASK_IPS=true hides the last part of
# addresses in the PDF.
LAB_REPORT_EMAIL_ENABLED=
LAB_REPORT_EMAIL_TO=
LAB_REPORT_MASK_IPS=

# --- Live demo (docs/soc.md, "Live demo") -----------------------------------------------------
# Lets an admin start the fixed attack run from the dashboard's "Live demo" page. The SOC only
# queues it; the demo runner on this host (scripts/demo_runner.py) runs the attacks and reads the
# same value from here. Blank = demo mode off. At least 32 characters; make one with
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
IDPS_SOC_DEMO_TOKEN=

# C6 evidence worker (docs/c6.md). Use a separate locally generated secret.
IDPS_SOC_C6_TOKEN=
