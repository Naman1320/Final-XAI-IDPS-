# The lab SOC's PostgreSQL: the official image plus a start script that makes the password and
# an init script that creates the SOC's (non-superuser) role.
FROM postgres:16-alpine
COPY soc/db-start.sh /usr/local/bin/db-start.sh
COPY soc/db-init.sh /docker-entrypoint-initdb.d/10-soc-role.sh
RUN chmod 0755 /usr/local/bin/db-start.sh /docker-entrypoint-initdb.d/10-soc-role.sh
ENV POSTGRES_DB=idps POSTGRES_INITDB_ARGS=--auth=scram-sha-256
ENTRYPOINT ["/usr/local/bin/db-start.sh"]
