#!/bin/bash
# First-boot setup of the SOC host (rendered by Terraform's templatefile()).
# Installs Docker, writes /opt/idps/docker-compose.yml, and runs /opt/idps/start.sh, which
# reads the secrets from SSM Parameter Store and starts the stack. Log: /var/log/idps-bootstrap.log
# Note for editors: in this file a literal dollar-brace must be written as dollar-dollar-brace.
set -euo pipefail
exec > >(tee -a /var/log/idps-bootstrap.log) 2>&1

# The instance can boot before its route to the internet works: wait, and retry downloads.
wait_for_network() {
  local i
  for i in $(seq 1 30); do
    if curl -fsS -m 5 -o /dev/null https://checkip.amazonaws.com; then return 0; fi
    echo "waiting for the network ($i/30)"
    sleep 5
  done
  echo "no network after 150 s: giving up (re-run this script from an SSM session)" >&2
  return 1
}
retry() {
  local n=0
  until "$@"; do
    n=$((n + 1))
    if [ "$n" -ge 5 ]; then return 1; fi
    echo "retrying ($n/5): $*"
    sleep 10
  done
}
wait_for_network

retry dnf install -y docker git
systemctl enable --now docker

# 1 GB of RAM is tight for PostgreSQL plus pip: add swap.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

# Docker Compose plugin (not in the Amazon Linux 2023 repositories). The checksum comes from the
# same release page, so it detects a damaged download, not a compromised release.
ARCH=$(uname -m)
PLUGIN_DIR=/usr/local/lib/docker/cli-plugins
mkdir -p "$PLUGIN_DIR"
BASE="https://github.com/docker/compose/releases/download/${compose_version}"
retry curl -fsSL -o "$PLUGIN_DIR/docker-compose" "$BASE/docker-compose-linux-$ARCH"
retry curl -fsSL -o /tmp/compose.sha256 "$BASE/docker-compose-linux-$ARCH.sha256"
echo "$(cut -d' ' -f1 /tmp/compose.sha256)  $PLUGIN_DIR/docker-compose" | sha256sum -c -
chmod +x "$PLUGIN_DIR/docker-compose"

mkdir -p /opt/idps
cd /opt/idps

%{ if repo_url != "" ~}
if [ ! -d /opt/idps/repo/.git ]; then
  retry git clone --depth 1 --branch "${repo_ref}" "${repo_url}" /opt/idps/repo
fi
%{ else ~}
mkdir -p /opt/idps/repo
echo "repo_url was not set: copy the project into /opt/idps/repo, then run /opt/idps/start.sh"
%{ endif ~}

cat > /opt/idps/Caddyfile <<'CADDY'
{
	# Caddy's own CA signs the certificate: Let's Encrypt cannot validate a host that only
	# admin_cidrs can reach. The certificate is issued for the Elastic IP, so clients can verify
	# it: give them Caddy's root certificate (infra/README.md, "Trust the SOC certificate").
	local_certs
}

https://${soc_public_ip} {
	tls internal
	# The dashboard (soc/web) is not served yet; add a file_server block here when it is.
	# Largest body any endpoint accepts (/ingest/alerts, 10 MiB: soc/api/limits.py) plus margin; the
	# API enforces tighter limits per path, this one stops oversized bodies at the edge.
	request_body {
		max_size 11MiB
	}
	# The dashboard must not be framed (clickjacking).
	header {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	reverse_proxy api:8000
}

http:// {
	redir https://{host}{uri} permanent
}
CADDY

cat > /opt/idps/docker-compose.yml <<'COMPOSE'
# One host, one API process (the live feed is in-process; see docs/soc.md).
services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: idps
      POSTGRES_USER: idps
      POSTGRES_PASSWORD: $${DB_PASSWORD}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U idps -d idps"]
      interval: 5s
      timeout: 3s
      retries: 20

  api:
    image: python:3.12-slim
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    working_dir: /repo
    volumes:
      - /opt/idps/repo:/repo:ro
    env_file: .env
    environment:
      PYTHONPATH: /repo
      PYTHONDONTWRITEBYTECODE: "1"
    # The API needs only these packages (not the ML stack); versions come from the lock file.
    # tests/test_soc_step11_hardening.py checks this list covers what soc.api imports.
    # Mutual TLS for sensors is not available here: Caddy terminates TLS in front of the API
    # (docs/soc.md, "Sensor certificates"); keep IDPS_SOC_SENSOR_MTLS_REQUIRED off.
    command: >
      sh -c "pip install --no-cache-dir -c /repo/requirements.lock
      fastapi uvicorn websockets sqlalchemy pydantic pydantic-settings pyjwt anthropic geoip2
      argon2-cffi 'psycopg[binary]' alembic cryptography segno pandas reportlab
      && exec uvicorn soc.api.main:app --host 0.0.0.0 --port 8000
      --proxy-headers --forwarded-allow-ips='*' --ws-max-size 65536"
    # No published ports: only Caddy, on the same network, reaches the API.

  caddy:
    image: caddy:2
    restart: unless-stopped
    depends_on:
      - api
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/idps/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data

volumes:
  pgdata:
  caddy_data:
COMPOSE

cat > /opt/idps/start.sh <<'START'
#!/bin/bash
# Reads the secrets from SSM Parameter Store into /opt/idps/.env (mode 600) and starts the stack.
# Run it again (sudo /opt/idps/start.sh) after you create the parameters with aws ssm put-parameter.
set -euo pipefail
cd /opt/idps
umask 077

# The parameters are created by hand (aws ssm put-parameter --key-id <ssm_kms_key_id>), not by
# Terraform. A missing parameter is an empty value; any other error (no permission, no key access)
# stops the script instead of being mistaken for "not set".
get() {
  local out
  if out=$(aws ssm get-parameter --region "${region}" --with-decryption \
      --name "$1" --query Parameter.Value --output text 2>/dev/null); then
    printf '%s' "$out"
    return 0
  fi
  out=$(aws ssm get-parameter --region "${region}" --name "$1" 2>&1 || true)
  if printf '%s' "$out" | grep -q ParameterNotFound; then
    printf ''
    return 0
  fi
  echo "cannot read $1: $out" >&2
  return 1
}

JWT=$(get "${ssm_prefix}/jwt-secret")
ANTHROPIC=$(get "${ssm_prefix}/anthropic-api-key")
MAXMIND=$(get "${ssm_prefix}/maxmind-key")

if [ "$${#JWT}" -lt 32 ]; then
  echo "The JWT secret (${ssm_prefix}/jwt-secret) is missing or shorter than 32 characters."
  echo "Create it with aws ssm put-parameter (infra/README.md), then run this script again."
  exit 1
fi
# The assistant and the map are optional: a missing parameter switches them off.

if [ ! -s db_password ]; then
  openssl rand -hex 24 > db_password
fi
DB_PASSWORD=$(cat db_password)

{
  echo "DB_PASSWORD=$DB_PASSWORD"
  echo "IDPS_SOC_DATABASE_URL=postgresql+psycopg://idps:$DB_PASSWORD@db:5432/idps"
  echo "IDPS_SOC_JWT_SECRET=$JWT"
  echo "IDPS_SOC_BLOCK_ALLOWLIST=${block_allowlist}"
  # Unset (not empty) when the parameter does not exist, so the SOC treats the feature as off.
  if [ -n "$ANTHROPIC" ]; then echo "ANTHROPIC_API_KEY=$ANTHROPIC"; fi
  # Kept for downloading GeoLite2 (see docs/cloud.md); the API itself reads IDPS_SOC_GEOIP_DB.
  if [ -n "$MAXMIND" ]; then echo "MAXMIND_LICENSE_KEY=$MAXMIND"; fi
} > .env.new
mv .env.new .env

docker compose up -d
START
chmod 700 /opt/idps/start.sh

/opt/idps/start.sh || echo "start.sh stopped (see message above); fix the secrets and run it again"
